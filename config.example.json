    "save_limit": 0,
    "auto_test": true,
    "remote_url": ""
  },
  "notify": {
    "email": {
      "enabled": false,
      "smtp_host": "smtp.aliyun.com",
      "smtp_port": 465,
      "use_ssl": true,
      "username": "发件账号@example.com",
      "password": "SMTP授权码或密码",
      "from_addr": "发件账号@example.com",
      "to_addrs": ["收件人1@example.com", "收件人2@example.com"],
