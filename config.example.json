{
  "security": {
    "encryption_enabled": false,
    "config_key": "请修改为至少 8 个字符的密钥",
    "encrypted_file": "data/config.encrypted.json"
  },
  "config_sync": {
    "enabled": false,
    "url": "https://你的配置服务.example.com/config",
    "method": "GET",
    "token": "",
    "token_header": "Authorization",
    "token_prefix": "Bearer",
    "headers": {},
    "body": null,
    "response_field": "",
    "timeout": 20,
    "auto_before_checkin": true
  },
  "proxy_pool": {
    "enabled": false,
    "test_url": "https://api.ipify.org",
    "timeout": 8,
    "max_workers": 25,
    "max_proxies": 250,
    "ip_swap_limit": 10,
    "sources": [],
