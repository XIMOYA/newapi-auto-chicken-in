      "timeout": 20
    }
  },
  "ai": {
    "enabled": false,
    "base_url": "https://你的站点.com/v1",
    "api_key": "sk-xxxx",
    "model": "gpt-4o-mini",
    "timeout": 60,
    "max_retries": 2
  },
  "browser": {
    "driver": "camoufox",
    "headless": "virtual",
